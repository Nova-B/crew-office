# Crew Office 환경변수 예시. 자세한 설명은 ENVIRONMENT.md 를 보세요.
# 개발 서버(`npm run dev`)는 저장소의 .env.local 을 읽습니다 — 이 파일을 복사해 쓰세요.

# 세션 토큰 서명 키. `openssl rand -hex 32` 등으로 만든 긴 난수를 넣습니다.
JWT_SECRET=change-me-to-a-random-64-char-string

# 선택: CLI 실행 파일을 자동으로 못 찾을 때 직접 지정합니다(src/lib/adapters/cli-executable.ts).
# CREW_CLAUDE_PATH=C:\path\to\claude.exe
# CREW_CODEX_PATH=C:\path\to\codex.js
# 선택: npm 전역 node_modules 위치가 기본값(%APPDATA%\npm\node_modules)과 다를 때(Windows).
# CREW_NPM_ROOT=C:\path\to\npm\node_modules
